        "wires": [],
        "info": "const dados = msg.payload;\r\n\r\nmsg.payload = [\r\n    {\r\n        measurement: \"dados_grafana\",\r\n        tags: {\r\n            id_idoso: dados.id\r\n        },\r\n        fields: {\r\n            aceleracao: parseFloat(dados.aceleracao),\r\n            panico: dados.panico === true ? 1 : 0\r\n        }\r\n    }\r\n];\r\n\r\nreturn msg;"
    },
    {
        "id": "9fd325f49ad765dd",
        "type": "function",
        "z": "fluxo_idosos_mackenzie_v2",
        "name": "TratarDadosGrafana",
        "func": "var dados = (typeof msg.payload === \"string\") \n    ? JSON.parse(msg.payload) \n    : msg.payload;\n\nvar acel = parseFloat(dados.aceleracao);\nvar panico = (dados.panico === true || dados.panico === \"true\") ? 1 : 0;\nvar id = String(dados.id);\n\nif (isNaN(acel)) return null;\n\nmsg.payload = [\n    [\n        { aceleracao: acel, panico: panico },\n        { id_idoso: id }\n    ]\n];\n\ndelete msg.tags;\nreturn msg;",
        "outputs": 1,

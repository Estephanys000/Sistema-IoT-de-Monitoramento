    {
        "id": "javascript_decisao",
        "type": "function",
        "z": "fluxo_idosos_mackenzie_v2",
        "name": "Valida Queda e Pânico",
        "func": "// Garante que o payload vindo do Wokwi seja tratado como um objeto JSON válido\nvar dados = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nvar panico = dados.panico;\nvar aceleracao = parseFloat(dados.aceleracao);\nvar idPaciente = dados.id;\n\n// Validação das Regras de Negócio de Queda ou Pânico\nif (panico === true || aceleracao > 3.0) {\n    var texto = \"\";\n    \n    if (idPaciente === \"idoso_01\") {\n        texto = \"🚨 ALERTA MACKENZIE: Emergência com o Sr. João (Idoso 01)! Queda ou botão de pânico acionado.\";\n    } else if (idPaciente === \"idoso_02\") {\n        texto = \"🚨 ALERTA MACKENZIE: Emergência com a Sra. Maria (Idoso 02)! Queda ou botão de pânico acionado.\";\n    } else {\n        texto = \"🚨 ALERTA MACKENZIE: Emergência com paciente desconhecido!\";\n    }\n    \n    // Entrega o texto puro exatamente como o nó verde do professor espera\n    msg.payload = texto; \n    return msg; // Passa adiante para o Delay / WhatsApp\n}\n\nreturn null; // Não faz nada se estiver tudo normal",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
